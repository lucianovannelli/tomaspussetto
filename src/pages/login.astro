---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Acceso | KSC Mobile">
  <main class="relative min-h-dvh w-full overflow-hidden bg-[#f8f9ff] flex items-center justify-center p-6 font-['Plus_Jakarta_Sans']" transition:animate="slide">
    <!-- Particles Container -->
    <div id="particles-container" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

    <!-- Dynamic Background Elements (Soft Light Purple) -->
    <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-brand-500/10 blur-[100px] rounded-full animate-blob"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] bg-brand-400/5 blur-[100px] rounded-full animate-blob animation-delay-2000"></div>
    <div class="absolute top-[20%] right-[10%] w-[30%] h-[30%] bg-brand-600/5 blur-[80px] rounded-full animate-blob animation-delay-4000"></div>

    <!-- Background Grid Overlay (Subtle) -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/soft-wallpaper.png')] opacity-[0.2] pointer-events-none"></div>

    <section class="relative z-10 w-full max-w-md space-y-8">
      <!-- Logo Area with Entrance Animation -->
      <div class="flex flex-col items-center space-y-6 animate-reveal">
        <div class="relative group">
          <!-- Animated Glow -->
          <div class="absolute inset-0 bg-brand-500 blur-3xl opacity-20 group-hover:opacity-30 animate-pulse-slow transition-opacity"></div>
          
          <!-- Orbiting ring -->
          <div class="absolute -inset-4 border border-brand-500/10 rounded-[32px] animate-spin-slow"></div>
          
          <div class="relative w-28 h-28 shrink-0 aspect-square bg-white rounded-3xl border-8 border-brand-700 flex flex-col items-center justify-center shadow-[0_10px_30px_-5px_rgba(139,92,246,0.2)] transform hover:scale-110 transition-transform duration-500" transition:name="brand-logo">
            <span class="text-4xl font-black text-brand-700 leading-none tracking-tighter" style="font-family: 'Arial Black', Impact, sans-serif;">KSC</span>
            <span class="text-[10px] font-black text-brand-700 uppercase tracking-[0.15em] mt-0.5" style="font-family: 'Arial Black', Impact, sans-serif;">Fitness</span>
          </div>
        </div>
        
        <div class="text-center space-y-2">
          <div class="flex items-center justify-center gap-3 animate-text-reveal animation-delay-500">
            <div class="h-[1px] w-8 bg-gradient-to-r from-transparent to-slate-200"></div>
            <p class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400">Mendoza 2434</p>
            <div class="h-[1px] w-8 bg-gradient-to-l from-transparent to-slate-200"></div>
          </div>
        </div>
      </div>

      <!-- Glassmorphism Card (Light Theme) -->
      <div class="relative overflow-hidden rounded-[38px] border border-white bg-white/60 p-8 backdrop-blur-2xl shadow-[0_20px_50px_rgba(139,92,246,0.08)] animate-card-reveal">
        <!-- Inner decorative light -->
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-brand-500/5 blur-3xl rounded-full"></div>
        
        <form id="login-form" class="space-y-8 relative z-10">
          <div class="space-y-3 animate-fade-in animation-delay-700">
            <div class="flex justify-between items-end px-1">
              <label for="member-id" class="block text-[11px] font-black uppercase tracking-widest text-slate-400">
                Identificación de Socio
              </label>
              <span class="text-[10px] font-bold text-brand-500/40">ID Requerido</span>
            </div>
            
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 flex items-center pl-5 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-300 group-focus-within:text-brand-500 transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
              </div>
              <input
                id="member-id"
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                class="block w-full h-16 pl-14 pr-6 bg-slate-50/50 border border-slate-100 rounded-2xl text-slate-900 font-bold text-xl placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500/30 focus:bg-white transition-all duration-300"
                placeholder={import.meta.env.PUBLIC_KSC_DEMO_MODE === 'true' ? '999 o cualquier número' : '0000'}
                required
              />
            </div>
          </div>

          <p id="login-error" class="hidden text-sm font-bold text-red-500 text-center animate-shake"></p>

          <button 
            type="submit" 
            class="login-holographic-btn animate-fade-in animation-delay-1000"
          >
            <!-- Sweep de luz -->
            <div class="lhb-sweep"></div>
            <!-- Texto con shimmer -->
            <span class="lhb-text">Ingresar</span>
          </button>

          <div id="demo-login-container" class="hidden relative flex flex-col items-center gap-3 pt-2">
            <div class="flex items-center gap-2 w-full animate-fade-in animation-delay-1000">
              <div class="h-[1px] flex-1 bg-slate-200"></div>
              <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">O probar el demo</span>
              <div class="h-[1px] flex-1 bg-slate-200"></div>
            </div>
            <button 
              id="demo-login-btn"
              type="button"
              class="group relative w-full h-14 overflow-hidden rounded-2xl border-2 border-dashed border-brand-300 hover:border-brand-500 bg-brand-50/50 hover:bg-brand-50 text-brand-700 font-extrabold text-base transition-all duration-300 active:scale-[0.98] flex items-center justify-center gap-2 animate-fade-in animation-delay-1200 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Acceso Socio Demo (Lautaro)
            </button>
          </div>
        </form>
      </div>

      <footer class="text-center animate-fade-in animation-delay-1200">
        <p class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-300">Powered by KSC Ecosystem</p>
      </footer>
    </section>
  </main>
</BaseLayout>

<style>
  /* Blob Animation */
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }
  .animate-blob {
    animation: blob 10s infinite alternate cubic-bezier(0.45, 0, 0.55, 1);
  }
  .animation-delay-2000 { animation-delay: 2s; }
  .animation-delay-4000 { animation-delay: 4s; }
  .animation-delay-500 { animation-delay: 0.5s; }
  .animation-delay-700 { animation-delay: 0.7s; }
  .animation-delay-1000 { animation-delay: 1s; }
  .animation-delay-1200 { animation-delay: 1.2s; }

  /* Entrance Animations */
  @keyframes reveal {
    from { opacity: 0; transform: scale(0.8) translateY(30px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .animate-reveal {
    animation: reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes cardReveal {
    from { opacity: 0; transform: translateY(40px); filter: blur(10px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .animate-card-reveal {
    animation: cardReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  @keyframes textReveal {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-text-reveal {
    animation: textReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.15; transform: scale(1); }
    50% { opacity: 0.25; transform: scale(1.1); }
  }
  .animate-pulse-slow {
    animation: pulse-slow 5s infinite ease-in-out;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }
  .animate-shake {
    animation: shake 0.3s ease-in-out 3;
  }

  /* Particles */
  :global(.particle) {
    position: absolute;
    background: #8b5cf6;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0.3;
  }

  /* ── Botón Ingresar holográfico ── */
  .login-holographic-btn {
    position: relative;
    width: 100%;
    height: 4rem;
    border-radius: 1rem;
    border: 1px solid transparent;
    background: linear-gradient(135deg, #1e1b2e 0%, #2d1f4e 45%, #1a1040 100%);
    background-clip: padding-box;
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.45),
      0 4px 24px rgba(124, 58, 237, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-holographic-btn:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.65),
      0 8px 32px rgba(124, 58, 237, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .login-holographic-btn:active {
    transform: scale(0.985);
  }

  /* Aurora glow exterior */
  .login-holographic-btn::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 1.1rem;
    background: linear-gradient(
      45deg,
      rgba(139, 92, 246, 0.0),
      rgba(167, 139, 250, 0.5),
      rgba(216, 180, 254, 0.25),
      rgba(139, 92, 246, 0.0)
    );
    background-size: 300% 300%;
    animation: lhb-aurora 8s ease-in-out infinite;
    z-index: -1;
    filter: blur(8px);
  }

  /* Sweep de luz */
  .lhb-sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 15%,
      rgba(255, 255, 255, 0.06) 30%,
      rgba(255, 255, 255, 0.13) 50%,
      rgba(255, 255, 255, 0.06) 70%,
      transparent 85%
    );
    background-size: 250% 100%;
    animation: lhb-sweep 5.5s ease-in-out infinite;
    border-radius: inherit;
    pointer-events: none;
  }

  /* Texto shimmer */
  .lhb-text {
    position: relative;
    z-index: 1;
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    background: linear-gradient(
      100deg,
      #c4b5fd 0%,
      #ede9fe 25%,
      #ffffff 45%,
      #ede9fe 60%,
      #c4b5fd 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: lhb-shimmer 6s ease-in-out infinite;
  }

  @keyframes lhb-shimmer {
    0%   { background-position: 100% 50%; }
    50%  { background-position: 0%   50%; }
    100% { background-position: 100% 50%; }
  }

  @keyframes lhb-sweep {
    0%   { background-position: 200%  0; }
    100% { background-position: -200% 0; }
  }

  @keyframes lhb-aurora {
    0%   { background-position: 0%   50%; opacity: 0.6; }
    33%  { background-position: 100% 50%; opacity: 1;   }
    66%  { background-position: 50%  0%;  opacity: 0.7; }
    100% { background-position: 0%   50%; opacity: 0.6; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  // Particles logic
  function createParticles() {
    const container = document.getElementById('particles-container');
    if (!container) return;
    
    container.innerHTML = '';
    const particleCount = 20;
    
    for (let i = 0; i < particleCount; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      
      const size = Math.random() * 6 + 2;
      const x = Math.random() * 100;
      const y = Math.random() * 100;
      const duration = Math.random() * 20 + 10;
      const delay = Math.random() * -20;
      
      p.style.width = `${size}px`;
      p.style.height = `${size}px`;
      p.style.left = `${x}%`;
      p.style.top = `${y}%`;
      p.style.animation = `float ${duration}s linear ${delay}s infinite`;
      
      const xMove = (Math.random() - 0.5) * 100;
      const yMove = (Math.random() - 0.5) * 100;
      
      p.animate([
        { transform: 'translate(0, 0)', opacity: 0 },
        { transform: `translate(${xMove / 2}px, ${yMove / 2}px)`, opacity: 0.3, offset: 0.5 },
        { transform: `translate(${xMove}px, ${yMove}px)`, opacity: 0 }
      ], {
        duration: duration * 1000,
        iterations: Infinity,
        delay: delay * 1000,
        easing: 'ease-in-out'
      });
      
      container.appendChild(p);
    }
  }

  function initLogin() {
    const form = document.getElementById('login-form');
    if (!form) return;

    createParticles();

    // Support dynamic demo mode parameter in URL
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('demo') === 'true') {
      localStorage.setItem('ksc_demo_mode', 'true');
    }

    const isDemo = localStorage.getItem('ksc_demo_mode') === 'true' || import.meta.env.PUBLIC_KSC_DEMO_MODE === 'true';

    const storageKey = 'ksc_member_id';
    const existingId = localStorage.getItem(storageKey);
    if (existingId && /^\d+$/.test(existingId.trim())) {
      navigate('/dashboard', { history: 'replace' });
      return;
    }

    const input = document.getElementById('member-id');
    const error = document.getElementById('login-error');
    const demoContainer = document.getElementById('demo-login-container');

    if (isDemo) {
      if (input instanceof HTMLInputElement) {
        input.placeholder = '999 o cualquier número';
      }
      if (demoContainer) {
        demoContainer.classList.remove('hidden');
      }
    } else {
      if (input instanceof HTMLInputElement) {
        input.placeholder = '0000';
      }
      if (demoContainer) {
        demoContainer.classList.add('hidden');
      }
    }

    if (form instanceof HTMLFormElement && input instanceof HTMLInputElement && error instanceof HTMLElement) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const memberId = input.value.trim();
        if (!/^\d+$/.test(memberId)) {
          error.textContent = 'ID de socio inválido.';
          error.classList.remove('hidden');
          error.classList.add('animate-shake');
          setTimeout(() => error.classList.remove('animate-shake'), 400);
          return;
        }
        localStorage.setItem(storageKey, memberId);
        navigate('/dashboard', { history: 'replace' });
      });
    }

    const demoBtn = document.getElementById('demo-login-btn');
    if (demoBtn) {
      demoBtn.addEventListener('click', () => {
        localStorage.setItem(storageKey, '999');
        navigate('/dashboard', { history: 'replace' });
      });
    }
  }

  // Run on page load and after client-side transitions
  document.addEventListener('astro:page-load', initLogin);
</script>
